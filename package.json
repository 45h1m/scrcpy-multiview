{
    "name": "multi-view",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "dev": "nodemon --watch . --exec \"electron .\"",
        "start": "electron .",
        "build": "electron-builder",
        "build:win": "electron-builder --win",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux"
    },
    "build": {
        "appId": "com.firebit.desktop.multi-view",
        "productName": "Multi Scrcpy View",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.ico"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "icon": "build/icon.icns"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "build/icon.png"
        }
    },
    "devDependencies": {
        "electron": "^33.3.1",
        "electron-bundler": "^0.0.0-alpha.0.0",
        "nodemon": "^3.1.9"
    }
}
